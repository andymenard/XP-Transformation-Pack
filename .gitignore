# Windows XP media and Microsoft-copyrighted assets never enter this repo.
# They are user-supplied or fetched at setup time; tests find the corpus
# through a configured path (see app/paths.py).
*.msstyles
*.theme
*.iso
iso/
samples/

# Build output
build/
out/
refharness/build/

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/

# Local state
app/schemes/user/
app/plugins/
refharness/share/
# (.theme files XPLasma writes itself: a test scheme, and XP's stock Classic
# schemes -- names and numbers, as app/schemes/xp_classic_schemes.json had them.)
!tests/oracle/schemes/*.theme
!src/app/data/schemes/*.theme
