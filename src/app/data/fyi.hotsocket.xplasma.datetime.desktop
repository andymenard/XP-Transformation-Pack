[Desktop Entry]
Type=Application
Name=Date and Time Properties (XPlasma)
GenericName=Date and time
Comment=Set the date, time and time zone, as Windows XP did
Exec=xplasma-edit --date-time
Icon=preferences-system-time
Terminal=false
Categories=Settings;
Keywords=Windows;XP;date;time;clock;time zone;XPlasma;
